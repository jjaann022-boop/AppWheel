<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="36dp"
    android:gravity="center" android:orientation="horizontal">
    <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:paddingStart="8dp" android:maxLines="1"
        android:ellipsize="end" android:textSize="14sp" android:textStyle="bold" />
    <ImageView android:id="@+id/up" android:layout_width="36dp" android:layout_height="36dp"
        android:scaleType="center" android:src="@drawable/ic_up"
        android:contentDescription="@string/btn_up" />
    <ImageView android:id="@+id/down" android:layout_width="36dp" android:layout_height="36dp"
        android:scaleType="center" android:src="@drawable/ic_down"
        android:contentDescription="@string/btn_down" />
    <ImageView android:id="@+id/wheel" android:layout_width="36dp" android:layout_height="36dp"
        android:scaleType="center" android:src="@drawable/ic_wheel"
        android:contentDescription="@string/btn_wheel" />
    <ImageView android:id="@+id/refresh" android:layout_width="36dp" android:layout_height="36dp"
        android:scaleType="center" android:src="@drawable/ic_refresh"
        android:contentDescription="@string/btn_refresh" />
    <ImageView android:id="@+id/settings" android:layout_width="36dp" android:layout_height="36dp"
        android:scaleType="center" android:src="@drawable/ic_settings"
        android:contentDescription="@string/btn_settings" />
</LinearLayout>
