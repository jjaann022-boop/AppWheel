<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/row" android:layout_width="match_parent" android:layout_height="68dp"
    android:orientation="horizontal" android:gravity="center_vertical"
    android:paddingStart="8dp" android:paddingEnd="8dp">
    <ImageView android:id="@+id/icon" android:layout_width="52dp" android:layout_height="52dp"
        android:importantForAccessibility="no" />
    <TextView android:id="@+id/label" android:layout_width="0dp" android:layout_weight="1"
        android:layout_height="wrap_content" android:layout_marginStart="12dp"
        android:maxLines="1" android:ellipsize="end"
        android:textColor="#FFFFFF" android:textSize="18sp" />
</LinearLayout>
